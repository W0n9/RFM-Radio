	<string name="pref_tuner_rds_description">RDS - Radio Data System（无线电数据系统）\n显示电台发送的广播相关信息。\nPS - Program Service（通常为电台名称）\nRT - Radio Text（通常为当前曲目名称或电台信息）\nAF - Alternative Frequencies（同一电台在邻近地区的其他播出频率列表）\nPTY - Program TYpe（电台的节目类型）</string>
	<string name="pref_header_recording">录音</string>
	<string name="pref_recording_path_title">保存子目录</string>
	<string name="pref_recording_name_title">文件名</string>
	<string name="pref_recording_path_name_description" tools:ignore="TypographyDashes">可用变量：\n$y - 年\n$m - 月\n$d - 日\n$h - 时\n$i - 分\n$s - 秒\n$f - 频率（例如 103.4 MHz = 1034）\n$r - 10000-99999 的随机数\n录音保存在 Music/RFM-Recordings 内。\n目录值必须相对于该根目录。\n示例：\n目录：station/$y-$m-$d -> Music/RFM-Recordings/station/2020-01-27\n文件名：Rec-$h_$i_$s_$f -> Rec_23_01_49_0906.wav</string>
	<string name="pref_recording_format_title">录音格式</string>
	<string name="pref_recording_format_wav">WAV PCM 16 位</string>
	<string name="pref_recording_format_mp3_128">MP3 128kbps</string>
	<string name="pref_recording_format_mp3_192">MP3 192kbps</string>
