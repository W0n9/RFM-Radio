<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
		xmlns:android="http://schemas.android.com/apk/res/android"
		xmlns:app="http://schemas.android.com/apk/res-auto"
		xmlns:tools="http://schemas.android.com/tools"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="@color/c_bg"
		android:fitsSystemWindows="true"
		tools:context=".activity.MainActivity">

	<!-- ===================== Top bar (C language: no app bar) ===================== -->
	<TextView
			android:id="@+id/brand_mark"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginStart="22dp"
			android:layout_marginTop="16dp"
			android:fontFamily="sans-serif-medium"
			android:letterSpacing="0.28"
			android:text="@string/brand_mark"
			android:textColor="@color/c_ink_faint"
			android:textSize="12sp"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toTopOf="parent" />

	<ImageButton
			android:id="@+id/overflow_button"
			android:layout_width="40dp"
			android:layout_height="40dp"
			android:layout_marginTop="4dp"
			android:layout_marginEnd="12dp"
			android:background="?android:attr/selectableItemBackgroundBorderless"
			android:contentDescription="@string/menu_more"
			android:src="@drawable/ic_more_vert"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintTop_toTopOf="parent"
			app:tint="@color/c_ink_dim" />

	<ImageButton
			android:id="@+id/settings_button"
			android:layout_width="40dp"
			android:layout_height="40dp"
			android:layout_marginTop="4dp"
			android:background="?android:attr/selectableItemBackgroundBorderless"
			android:contentDescription="@string/settings_cd"
			android:src="@drawable/ic_settings"
			app:layout_constraintEnd_toStartOf="@id/overflow_button"
			app:layout_constraintTop_toTopOf="parent"
			app:tint="@color/c_ink_dim" />

	<com.vlad805.fmradio.view.RecordCapsuleView
			android:id="@+id/rec_capsule"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginEnd="4dp"
			android:contentDescription="@string/menu_record"
			app:layout_constraintBottom_toBottomOf="@id/settings_button"
			app:layout_constraintEnd_toStartOf="@id/settings_button"
			app:layout_constraintTop_toTopOf="@id/settings_button" />

	<!-- ===================== Blob + frequency overlay ===================== -->
	<FrameLayout
			android:id="@+id/art_container"
			android:layout_width="0dp"
			android:layout_height="240dp"
			android:layout_marginTop="4dp"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@id/settings_button">

		<com.vlad805.fmradio.view.BlobView
				android:id="@+id/blob"
				android:layout_width="240dp"
				android:layout_height="240dp"
				android:layout_gravity="center" />

		<LinearLayout
				android:id="@+id/freq_overlay"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_gravity="center"
				android:gravity="bottom"
				android:orientation="horizontal">

			<TextView
					android:id="@+id/frequency_text"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:fontFamily="sans-serif-medium"
					android:fontFeatureSettings="tnum"
					android:textColor="@color/c_ink"
					android:textSize="29sp"
					tools:text="106.3" />

			<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginStart="3dp"
					android:layout_marginBottom="3dp"
					android:text="@string/freq_unit_mhz"
					android:textColor="@color/c_ink_dim"
					android:textSize="12sp" />
		</LinearLayout>
	</FrameLayout>

	<!-- ===================== Now playing ===================== -->
	<LinearLayout
			android:id="@+id/now_playing"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginStart="30dp"
			android:layout_marginEnd="30dp"
			android:gravity="center_horizontal"
			android:orientation="vertical"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@id/art_container">

		<TextView
				android:id="@+id/ps_text"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:ellipsize="end"
				android:fontFamily="sans-serif-medium"
				android:gravity="center"
				android:maxLines="1"
				android:textColor="@color/c_ink"
				android:textSize="30sp"
				tools:text="RECORD" />

		<TextView
				android:id="@+id/rt_text"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="7dp"
				android:ellipsize="marquee"
				android:gravity="center"
				android:marqueeRepeatLimit="-1"
				android:singleLine="true"
				android:textColor="@color/c_ink_dim"
				android:textSize="13.5sp"
				tools:text="ALOK/GRYFFIN/JULIA CHURCH — Never Letting Go" />

		<TextView
				android:id="@+id/pty_chip"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="10dp"
				android:background="@drawable/pty_chip_bg"
				android:paddingStart="12dp"
				android:paddingTop="4dp"
				android:paddingEnd="12dp"
				android:paddingBottom="4dp"
				android:textColor="@color/c_pty_text"
				android:textSize="11sp"
				android:visibility="gone"
				tools:text="Popular Music (Pop)"
				tools:visibility="visible" />

		<LinearLayout
				android:id="@+id/meta_row"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="9dp"
				android:gravity="center_vertical"
				android:orientation="horizontal">

			<com.vlad805.fmradio.view.SignalStrengthView
					android:id="@+id/signal_strength"
					android:layout_width="22dp"
					android:layout_height="22dp"
					android:contentDescription="@string/signal_strength_indicator" />

			<TextView
					android:id="@+id/stereo_mono"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginStart="10dp"
					android:letterSpacing="0.06"
					android:text="@string/mono_mode_label"
					android:textAllCaps="true"
					android:textColor="@color/c_ink_dim"
					android:textSize="11sp" />

			<TextView
					android:id="@+id/pi_text"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginStart="10dp"
					android:fontFamily="monospace"
					android:textColor="@color/c_ink_faint"
					android:textSize="11sp"
					tools:text="7849" />
		</LinearLayout>
	</LinearLayout>

	<!-- ===================== Transport ===================== -->
	<LinearLayout
			android:id="@+id/transport"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="16dp"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@id/now_playing">

		<ImageButton
				android:id="@+id/ctl_go_down"
				android:layout_width="50dp"
				android:layout_height="50dp"
				android:background="?android:attr/selectableItemBackgroundBorderless"
				android:contentDescription="@string/jump_down"
				android:src="@drawable/ic_go_down"
				app:tint="@color/c_ink" />

		<ImageButton
				android:id="@+id/ctl_toggle"
				android:layout_width="74dp"
				android:layout_height="74dp"
				android:layout_marginStart="30dp"
				android:layout_marginEnd="30dp"
				android:background="@drawable/btn_power_bg"
				android:contentDescription="@string/toggle_play_pause"
				android:src="@drawable/ic_play"
				app:tint="@color/c_bg" />

		<ImageButton
				android:id="@+id/ctl_go_up"
				android:layout_width="50dp"
				android:layout_height="50dp"
				android:background="?android:attr/selectableItemBackgroundBorderless"
				android:contentDescription="@string/jump_up"
				android:src="@drawable/ic_go_up"
				app:tint="@color/c_ink" />
	</LinearLayout>

	<!-- ===================== Frequency slider ===================== -->
	<LinearLayout
			android:id="@+id/slider_zone"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginStart="26dp"
			android:layout_marginTop="10dp"
			android:layout_marginEnd="26dp"
			android:orientation="vertical"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@id/transport">

		<com.vlad805.fmradio.view.FrequencySliderView
				android:id="@+id/frequency_slider"
				android:layout_width="match_parent"
				android:layout_height="48dp"
				android:contentDescription="@string/frequency_slider_cd" />

		<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:gravity="center_vertical"
				android:orientation="horizontal">

			<TextView
					android:id="@+id/band_min_label"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:fontFeatureSettings="tnum"
					android:textColor="@color/c_scale_label"
					android:textSize="10sp"
					tools:text="87.5" />

			<LinearLayout
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:gravity="center"
					android:orientation="horizontal">

				<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:letterSpacing="0.14"
						android:text="@string/seek_label"
						android:textColor="@color/c_ink_faint"
						android:textSize="10sp" />

				<TextView
						android:id="@+id/ctl_seek_down"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:background="?android:attr/selectableItemBackgroundBorderless"
						android:clickable="true"
						android:focusable="true"
						android:contentDescription="@string/seek_down"
						android:padding="8dp"
						android:text="@string/seek_backward_symbol"
						android:textColor="@color/c_ink_faint"
						android:textSize="11.5sp" />

				<TextView
						android:id="@+id/ctl_seek_up"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:background="?android:attr/selectableItemBackgroundBorderless"
						android:clickable="true"
						android:focusable="true"
						android:contentDescription="@string/seek_up"
						android:padding="8dp"
						android:text="@string/seek_forward_symbol"
						android:textColor="@color/c_ink_faint"
						android:textSize="11.5sp" />
			</LinearLayout>

			<TextView
					android:id="@+id/band_max_label"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:fontFeatureSettings="tnum"
					android:textColor="@color/c_scale_label"
					android:textSize="10sp"
					tools:text="108.0" />
		</LinearLayout>
	</LinearLayout>

	<!-- ===================== Favorites: horizontal chips ===================== -->
	<com.vlad805.fmradio.view.FavoriteChipsView
			android:id="@+id/favorite_list"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:paddingStart="22dp"
			android:paddingTop="6dp"
			android:paddingEnd="22dp"
			android:paddingBottom="16dp"
			app:layout_constraintBottom_toBottomOf="parent"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintStart_toStartOf="parent"
			app:layout_constraintTop_toBottomOf="@id/slider_zone"
			app:layout_constraintVertical_bias="1" />

</androidx.constraintlayout.widget.ConstraintLayout>
