	<string name="pref_tuner_rds_description">RDS - Radio Data System（無線電資料系統）\n顯示電台傳送的廣播相關資訊。\nPS - Program Service（通常為電台名稱）\nRT - Radio Text（通常為目前曲目名稱或電台資訊）\nAF - Alternative Frequencies（同一電台在鄰近地區的其他播出頻率清單）\nPTY - Program TYpe（電台的節目類型）</string>
	<string name="pref_header_recording">錄音</string>
	<string name="pref_recording_path_title">儲存子目錄</string>
	<string name="pref_recording_name_title">檔案名稱</string>
	<string name="pref_recording_path_name_description" tools:ignore="TypographyDashes">可用變數：\n$y - 年\n$m - 月\n$d - 日\n$h - 時\n$i - 分\n$s - 秒\n$f - 頻率（例如 103.4 MHz = 1034）\n$r - 10000-99999 的隨機數\n錄音儲存在 Music/RFM-Recordings 內。\n目錄值必須相對於該根目錄。\n範例：\n目錄：station/$y-$m-$d -> Music/RFM-Recordings/station/2020-01-27\n檔案名稱：Rec-$h_$i_$s_$f -> Rec_23_01_49_0906.wav</string>
	<string name="pref_recording_format_title">錄音格式</string>
